CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
# Firmware update over Bluetooth: if the new firmware resets before it has run long enough, the bootloader goes back to the old one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# The update is written from the Bluetooth host task (flash write + SHA-256 + screen), so give it more stack.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
# The update is checked with SHA-256 from the Bluetooth host task. Every update so far ended in a checksum mismatch although all bytes arrived
# in order, so use the software SHA-256 (slower by a fraction of a second, same result) in case the chip's SHA hardware is the cause.
CONFIG_MBEDTLS_HARDWARE_SHA=n
